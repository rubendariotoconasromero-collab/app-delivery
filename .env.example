# Solo desarrollo local; no reutilizar estas credenciales en un servidor público.
NODE_ENV=development
API_BIND_HOST=0.0.0.0
API_PORT=3000
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

POSTGRES_USER=appdelivery
POSTGRES_PASSWORD=appdelivery_dev
POSTGRES_DB=appdelivery_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://appdelivery:appdelivery_dev@127.0.0.1:5432/appdelivery_dev

REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379

MARKET_COUNTRY=BO
MARKET_CITY="Santa Cruz de la Sierra"
MARKET_CURRENCY=BOB
MARKET_CURRENCY_SYMBOL=Bs
MARKET_TIME_ZONE=America/La_Paz

# npm run setup genera un secreto aleatorio por entorno. Nunca compartir .env.
AUTH_SECRET=
# Solo desarrollo: devuelve el código OTP en la respuesta; prohibido en producción.
AUTH_OTP_DELIVERY=development
UPLOAD_DIR=.cache/uploads

# Loop 3: rutas OSRM y tarifas/cobertura de prueba, solo desarrollo.
TRIP_DEVELOPMENT_ENABLED=true
TRIP_OSRM_URL=https://router.project-osrm.org
TRIP_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
TRIP_COVERAGE_SOUTH=-17.90
TRIP_COVERAGE_NORTH=-17.65
TRIP_COVERAGE_WEST=-63.30
TRIP_COVERAGE_EAST=-63.02
TRIP_BASE_CENTS=500
TRIP_PER_KM_CENTS=200
TRIP_PER_MINUTE_CENTS=25
TRIP_MINIMUM_CENTS=800
TRIP_TARIFF_VERSION=scz-dev-v1
TRIP_QUOTE_TTL_SECONDS=180
TRIP_SEARCH_TTL_SECONDS=600
TRIP_OFFER_TTL_SECONDS=60
TRIP_GPS_MAX_AGE_SECONDS=60
TRIP_ARRIVAL_RADIUS_METERS=200
