# Solo desarrollo local; no reutilizar estas credenciales en un servidor público.
NODE_ENV=development
API_BIND_HOST=0.0.0.0
API_PORT=3000
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

POSTGRES_USER=appdelivery
POSTGRES_PASSWORD=appdelivery_dev
POSTGRES_DB=appdelivery_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://appdelivery:appdelivery_dev@127.0.0.1:5432/appdelivery_dev

REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379

MARKET_COUNTRY=BO
MARKET_CITY="Santa Cruz de la Sierra"
MARKET_CURRENCY=BOB
MARKET_CURRENCY_SYMBOL=Bs
MARKET_TIME_ZONE=America/La_Paz

# npm run setup genera un secreto aleatorio por entorno. Nunca compartir .env.
AUTH_SECRET=
# Solo desarrollo: devuelve el código OTP en la respuesta; prohibido en producción.
AUTH_OTP_DELIVERY=development
UPLOAD_DIR=.cache/uploads
