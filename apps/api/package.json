{
  "name": "@appdelivery/api",
  "version": "0.1.0",
  "private": true,
  "description": "API modular de AppDelivery para pasajeros y encomiendas",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "build": "nest build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "staff:create": "tsx scripts/create-staff.ts",
    "db:migrate": "tsx src/database/migrate.ts up",
    "db:status": "tsx src/database/migrate.ts status",
    "openapi:export": "tsx scripts/export-openapi.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/swagger": "^12.0.3",
    "dotenv": "^18.0.9",
    "pg": "^8.23.1",
    "redis": "^6.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.10",
    "@nestjs/testing": "^12.2.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
