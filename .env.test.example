# Entorno separado: no apunta a la base ni al Redis de desarrollo.
NODE_ENV=test
API_BIND_HOST=127.0.0.1
API_PORT=3001
CORS_ORIGINS=http://localhost:4200

POSTGRES_USER=appdelivery
POSTGRES_PASSWORD=appdelivery_test
POSTGRES_DB=appdelivery_test
POSTGRES_PORT=55432
DATABASE_URL=postgresql://appdelivery:appdelivery_test@127.0.0.1:55432/appdelivery_test

REDIS_PORT=56379
